# ─── Meilisearch ───────────────────────────────────────────────────────────────
# Master key for the local Meilisearch instance (must match the --master-key flag)
MEILI_MASTER_KEY=ayurveda-dev-key

# ─── MCP Server (optional) ────────────────────────────────────────────────────
# Bearer token clients must send to access the MCP server (leave blank to disable auth)
MCP_AUTH_TOKEN=

# ─── LLM Re-ranking (optional) ────────────────────────────────────────────────
# Provide ONE of these to enable AI-powered result re-ranking.
# If neither is set, search still works — it just skips the LLM re-rank step.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
